{
  "name": "@zhiloop/console-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/control-api",
      "@zhiloop/p3-console-runtime",
      "@zhiloop/p4-console-runtime"
    ],
    "allowedExternalDependencies": [
      "node:*",
      "zod"
    ],
    "requireDirectTests": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@zhiloop/control-api": "0.0.0",
    "@zhiloop/p3-console-runtime": "0.0.0",
    "@zhiloop/p4-console-runtime": "0.0.0",
    "zod": "^4.4.3"
  }
}
