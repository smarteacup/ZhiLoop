{
  "name": "@zhiloop/active-knowledge-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/closure-verifier",
      "@zhiloop/codex-context-injection",
      "@zhiloop/config",
      "@zhiloop/confirmation-writeback",
      "@zhiloop/context-orchestrator",
      "@zhiloop/domain",
      "@zhiloop/feedback-engine",
      "@zhiloop/interaction-policy",
      "@zhiloop/knowledge-mcp",
      "@zhiloop/knowledge-reranker",
      "@zhiloop/query-context",
      "@zhiloop/retrieval-engine",
      "@zhiloop/retrieval-evaluation",
      "@zhiloop/runtime-audit-store",
      "@zhiloop/stop-continuation"
    ],
    "allowedExternalDependencies": ["node:*"],
    "requireDirectTests": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
