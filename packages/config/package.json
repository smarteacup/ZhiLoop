{
  "name": "@zhiloop/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/domain",
      "@zhiloop/schemas"
    ],
    "allowedExternalDependencies": [
      "yaml",
      "zod"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@zhiloop/domain": "0.0.0",
    "@zhiloop/schemas": "0.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
