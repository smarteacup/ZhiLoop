{
  "name": "@zhiloop/knowledge-worker-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/config",
      "@zhiloop/conversation-ledger",
      "@zhiloop/conversation-normalizer",
      "@zhiloop/domain",
      "@zhiloop/episode-builder",
      "@zhiloop/evidence-engine",
      "@zhiloop/evidence-policy",
      "@zhiloop/knowledge-compiler",
      "@zhiloop/knowledge-evolution",
      "@zhiloop/knowledge-freshness",
      "@zhiloop/knowledge-indexer",
      "@zhiloop/knowledge-registry",
      "@zhiloop/markdown-repository",
      "@zhiloop/scope-resolver"
    ],
    "allowedExternalDependencies": ["node:*"],
    "requireDirectTests": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@zhiloop/config": "0.0.0",
    "@zhiloop/conversation-ledger": "0.0.0",
    "@zhiloop/conversation-normalizer": "0.0.0",
    "@zhiloop/domain": "0.0.0",
    "@zhiloop/episode-builder": "0.0.0",
    "@zhiloop/evidence-engine": "0.0.0",
    "@zhiloop/evidence-policy": "0.0.0",
    "@zhiloop/knowledge-compiler": "0.0.0",
    "@zhiloop/knowledge-evolution": "0.0.0",
    "@zhiloop/knowledge-freshness": "0.0.0",
    "@zhiloop/knowledge-indexer": "0.0.0",
    "@zhiloop/knowledge-registry": "0.0.0",
    "@zhiloop/markdown-repository": "0.0.0",
    "@zhiloop/scope-resolver": "0.0.0"
  }
}
