{
  "name": "@zhiloop/local-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": ["@zhiloop/plugin-runtime"],
    "allowedExternalDependencies": ["node:*"]
