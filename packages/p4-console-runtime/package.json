{
  "name": "@zhiloop/p4-console-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/active-knowledge-runtime",
      "@zhiloop/active-rollout-service",
      "@zhiloop/domain",
      "@zhiloop/feedback-engine",
      "@zhiloop/retrieval-evaluation",
      "@zhiloop/runtime-audit-store"
