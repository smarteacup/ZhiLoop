  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@zhiloop/active-knowledge-runtime": "0.0.0",
    "@zhiloop/active-rollout-service": "0.0.0",
    "@zhiloop/domain": "0.0.0",
    "@zhiloop/feedback-engine": "0.0.0",
    "@zhiloop/retrieval-evaluation": "0.0.0",
    "@zhiloop/runtime-audit-store": "0.0.0",
    "zod": "^4.4.3"
  }
