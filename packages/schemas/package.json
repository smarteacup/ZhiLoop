{
  "name": "@zhiloop/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "zhiloop": {
    "allowedWorkspaceDependencies": [
      "@zhiloop/domain"
    ],
    "allowedExternalDependencies": [
      "ajv",
      "ajv-formats"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@zhiloop/domain": "0.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
