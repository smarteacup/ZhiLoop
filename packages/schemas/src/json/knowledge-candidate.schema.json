{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zhiloop.dev/schemas/knowledge-candidate/v1",
  "title": "KnowledgeCandidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "candidateId",
    "compilerVersion",
    "status",
    "subjectKey",
    "kind",
    "scopeHint",
    "title",
    "summary",
    "body",
    "sourceEpisodes",
    "confidence",
    "createdAt",
    "correlationId",
    "assertions",
    "evidenceHints"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "candidateId": { "type": "string", "minLength": 1 },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "status": { "const": "PROPOSED" },
    "subjectKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"
    },
    "kind": {
      "enum": [
        "FACT",
        "REQUIREMENT",
        "DESIGN",
        "DECISION",
        "IMPLEMENTATION",
        "EXPERIENCE",
        "RULE",
        "PREFERENCE",
        "OPEN_QUESTION"
      ]
    },
    "claimMode": { "enum": ["CURRENT_STATE", "USER_DECISION", "FUTURE_REQUIREMENT"] },
    "locator": { "$ref": "#/definitions/knowledgeLocator" },
    "scopeHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCodes"],
      "properties": {
        "level": { "enum": ["TASK", "SYMBOL", "MODULE", "PROJECT", "USER", "TEAM", "GLOBAL"] },
        "taskId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "repositoryRemote": { "type": "string", "minLength": 1 },
        "modulePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "userId": { "type": "string", "minLength": 1 },
        "teamId": { "type": "string", "minLength": 1 },
        "reasonCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "sourceEpisodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertionId", "candidateId", "kind", "parameters", "createdAt"],
        "properties": {
          "assertionId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "USER_ACCEPTED",
              "USER_REJECTED",
              "SYMBOL_EXISTS",
              "CALL_PATH_EXISTS",
              "IMPACT_CONTAINS",
              "FILE_CONTAINS",
              "DEPENDENCY_PRESENT",
              "CONFIG_EQUALS",
              "COMMAND_SUCCEEDED",
              "TEST_PASSED",
              "CROSS_PROJECT_VERIFIED"
            ]
          },
          "parameters": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "oneOf": [
          {
            "properties": {
              "kind": { "enum": ["USER_ACCEPTED", "USER_REJECTED"] },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["statementRef"],
                "properties": { "statementRef": { "type": "string", "minLength": 1 } }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "SYMBOL_EXISTS" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectId", "symbol"],
                "properties": {
                  "projectId": { "type": "string", "minLength": 1 },
                  "symbol": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "CALL_PATH_EXISTS" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectId", "from", "to"],
                "properties": {
                  "projectId": { "type": "string", "minLength": 1 },
                  "from": { "type": "string", "minLength": 1 },
                  "to": { "type": "string", "minLength": 1 },
                  "maxDepth": { "type": "integer", "minimum": 1, "maximum": 32 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "IMPACT_CONTAINS" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectId", "symbol", "impactedSymbol"],
                "properties": {
                  "projectId": { "type": "string", "minLength": 1 },
                  "symbol": { "type": "string", "minLength": 1 },
                  "impactedSymbol": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "FILE_CONTAINS" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "expected", "matchMode"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "expected": { "type": "string" },
                  "matchMode": { "enum": ["EXACT", "REGEX", "STRUCTURAL"] }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "DEPENDENCY_PRESENT" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "versionConstraint": { "type": "string", "minLength": 1 },
                  "manifestPath": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "CONFIG_EQUALS" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "expected"],
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "expected": { "type": "string" },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "COMMAND_SUCCEEDED" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commandHash", "expectedExitCode"],
                "properties": {
                  "commandHash": { "type": "string", "minLength": 1 },
                  "expectedExitCode": { "type": "integer" }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "TEST_PASSED" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["testId"],
                "properties": {
                  "testId": { "type": "string", "minLength": 1 },
                  "commandHash": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "kind": { "const": "CROSS_PROJECT_VERIFIED" },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["subjectKey", "minimumProjects"],
                "properties": {
                  "subjectKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$" },
                  "minimumProjects": { "type": "integer", "minimum": 2 }
                }
              }
            }
          }
        ]
      }
    },
    "evidenceHints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "sourceRef", "correlationId"],
        "properties": {
          "type": {
            "enum": [
              "USER_STATEMENT",
              "CODE_SYMBOL",
              "CODE_RELATION",
              "CODE_IMPACT",
              "FILE_CONTENT",
              "DEPENDENCY",
              "CONFIGURATION",
              "COMMAND_RESULT",
              "TEST_RESULT",
              "CROSS_PROJECT"
            ]
          },
          "sourceRef": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "correlationId": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": { "properties": { "claimMode": {}, "locator": {} }, "required": ["claimMode", "locator"] }
    }
  ],
  "anyOf": [
    { "properties": { "assertions": { "type": "array", "minItems": 1 } } },
    { "properties": { "evidenceHints": { "type": "array", "minItems": 1 } } }
  ],
  "definitions": {
    "knowledgeLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectId", "observedRevision", "branchApplicability", "scenarioId", "scenarioKey", "scenarioTitle", "scenarioSummary", "modulePaths", "symbols", "entryPoints", "taskIntents", "applicability", "nonApplicability"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "repositoryRemote": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "observedRevision": {
          "type": "object", "additionalProperties": false, "required": ["dirty"],
          "properties": {
            "branch": { "type": "string", "minLength": 1, "maxLength": 500 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
            "dirty": { "type": "boolean" },
            "codegraphRevision": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "branchApplicability": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["mode", "branch"], "properties": { "mode": { "const": "EXACT_BRANCH" }, "branch": { "type": "string", "minLength": 1, "maxLength": 500 } } },
            { "type": "object", "additionalProperties": false, "required": ["mode", "baseCommit"], "properties": { "mode": { "const": "BRANCH_LINEAGE" }, "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" }, "observedBranch": { "type": "string", "minLength": 1, "maxLength": 500 } } },
            { "type": "object", "additionalProperties": false, "required": ["mode", "reason"], "properties": { "mode": { "const": "ALL_BRANCHES" }, "reason": { "type": "string", "minLength": 1, "maxLength": 1000 } } }
          ]
        },
        "scenarioId": { "type": "string", "minLength": 12, "maxLength": 1020, "pattern": "^scenario:" },
        "scenarioKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,}$" },
        "scenarioTitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scenarioSummary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "modulePaths": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "symbols": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "entryPoints": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "taskIntents": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "applicability": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "nonApplicability": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    }
  }
}
